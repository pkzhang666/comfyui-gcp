# GCP project
PROJECT_ID=your-gcp-project-id
REGION=us-central1
ZONE=us-central1-b

# Terraform remote state (GCS backend)
STATE_BUCKET=your-project-id-tf-state
# New installs should use the repo-aligned prefix below.
# Existing deployments can keep their current prefix to avoid state migration.
STATE_PREFIX=gcp-ai-studio/state

# GCS buckets for ComfyUI
MODELS_BUCKET=your-project-id-comfyui-models
OUTPUTS_BUCKET=your-project-id-comfyui-outputs

# VM name
VM_NAME=comfyui-vm

# Service toggles
ENABLE_COMFYUI=true
ENABLE_LLAMA=true
ENABLE_OPEN_WEBUI=true

# llama-server port (OpenAI-compatible API)
LLAMA_PORT=8080

# Open WebUI port
WEBUI_PORT=3000
